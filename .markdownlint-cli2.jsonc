{
  "config": {
    "default": true,
    // 한국어 문서는 줄 길이 제한을 두지 않는다
    "MD013": false,
    // 템플릿의 중복 섹션 제목 허용 (같은 레벨 내에서만 검사)
    "MD024": { "siblings_only": true },
    // 표 정렬 스타일 강제하지 않음
    "MD060": false,
    // agent 프롬프트·PR 템플릿은 H1으로 시작하지 않는다
    "MD041": false
  },
  "ignores": ["node_modules/**", "**/node_modules/**"]
}
